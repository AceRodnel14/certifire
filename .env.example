# Copy to .env and adjust. Every variable the app reads is listed here and in the README.

# --- App ---
PORT=8080
# Public URL as users see it (https://... behind a reverse proxy); cookies are Secure when it is https
BASE_URL=http://localhost:8080
LOG_LEVEL=info
# Compose builds DATABASE_URL from the POSTGRES_* values below. Set it yourself only when
# running the binary outside Compose (the password must be URL-safe, see README):
# DATABASE_URL=postgres://certifire:<password>@<db-host>:5432/certifire?sslmode=disable

# --- Compose ---
# Postgres container. REQUIRED: set POSTGRES_PASSWORD BEFORE the first start (Compose refuses
# to start without it, and it is fixed once the pg-data volume exists).
# Use letters and digits only: it is embedded in DATABASE_URL.
POSTGRES_USER=certifire
POSTGRES_PASSWORD=
POSTGRES_DB=certifire
# IMAGE=eacer/certifire:v1.0   # pin a release; default eacer/certifire:latest
# APP_BIND=127.0.0.1   # publish on loopback only when a proxy fronts the app
# APP_PORT=8080

# --- Backup ---
# BACKUP_ALL_ALLOWED_IPS=172.16.0.0/12   # direct (non-proxied) callers allowed to POST /api/backup-all; empty = disabled

# --- Reminders ---
# REMINDER_TZ=UTC            # time zone for the daily check
# REMINDER_TIME=00:00        # HH:MM in REMINDER_TZ
# REMINDER_STEPS=7,5,3,1,0   # days before expiry to remind
# REMINDER_LOCAL_CRON=true   # false when a Kubernetes CronJob runs `/app remind` (see k8s_cron/)
